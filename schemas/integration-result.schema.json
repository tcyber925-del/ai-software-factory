{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ai-software-factory.dev/schemas/integration-result.schema.json",
  "title":"Integration Result",
  "type":"object",
  "additionalProperties":false,
  "required":["work_unit_id","state","reason","verification","events"],
  "properties":{
    "work_unit_id":{"type":"string","minLength":1},
    "state":{"enum":["ready","blocked"]},
    "reason":{"type":"string","minLength":1},
    "verification":{"type":"object","additionalProperties":false,"required":["work_unit_id","status","checks"],"properties":{"work_unit_id":{"type":"string","minLength":1},"status":{"enum":["passed","failed","blocked"]},"checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","status"],"properties":{"name":{"type":"string"},"status":{"enum":["passed","failed","skipped"]},"evidence":{"type":"string"}}}},"attempt":{"type":"integer","minimum":1}}},
    "commit":{"type":"string","minLength":1},
    "events":{"type":"array","items":{"type":"object"}}
  }
}