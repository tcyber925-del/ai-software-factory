{
  "name": "ai-software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.build.json",
    "factory": "node dist/bin.js",
    "test": "vitest run",
    "verify": "npm run build && npm run build:cli && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
